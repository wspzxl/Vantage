# Copy to .env.local and fill in. Never commit .env.local (already in .gitignore).

# Supabase — from your project's Settings > API page
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, used by the ingestion/cron jobs. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Market data
FINNHUB_API_KEY=
FMP_API_KEY=

# Email alerts
RESEND_API_KEY=

# Secret used to authenticate cron-triggered ingestion requests (any random string)
CRON_SECRET=
